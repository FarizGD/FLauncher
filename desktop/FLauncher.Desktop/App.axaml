<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FLauncher.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#101419"/><Setter Property="Foreground" Value="#ECF1F5"/></Style>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#B6ECC5"/><Setter Property="Foreground" Value="#142B20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.nav.active"><Setter Property="Background" Value="#28392F"/><Setter Property="Foreground" Value="#B6ECC5"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#1B222A"/><Setter Property="BorderBrush" Value="#2D3742"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="24"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#A2AFBC"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12"/></Style>
  </Application.Styles>
</Application>
